# Explorer — production environment template.
# Copy the real values into the dokploy service "Environment" tab.
# Never commit real secrets: this file documents the required variables only.

# --- Rails -----------------------------------------------------------------
# Content of config/master.key (decrypts config/credentials.yml.enc)
RAILS_MASTER_KEY=
# Canonical app host — used in generated URLs (password-reset emails, etc.)
APP_HOST=expl.pro
# Puma threads (keep in sync with the DB pool in config/database.yml)
RAILS_MAX_THREADS=5

# --- Database (postgres container on the compose network) -------------------
DATABASE_URL=postgres://explorer:CHANGE_ME@postgres:5432/explorer_production
POSTGRES_USER=explorer
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=explorer_production

# --- Redis (redis container on the compose network) -------------------------
# Shared cache store + Action Cable
REDIS_URL=redis://redis:6379/1

# --- Email (Resend SMTP — the API key doubles as the SMTP password) ---------
RESEND_API_KEY=re_xxxxxxxxxxxx
MAILER_FROM=Explorer <no-reply@expl.pro>

# --- Mapbox (static map thumbnails on route cards) --------------------------
# Public pk. token from https://account.mapbox.com — read by
# Mapbox::StaticImage when credentials have no :mapbox/:access_token.
MAPBOX_ACCESS_TOKEN=

# --- Map page (MapLibre base map) -------------------------------------------
# Base-map style for /map, resolved by config/initializers/map.rb:
# credentials :map/:style_url → MAP_STYLE_URL → the keyless OpenFreeMap
# Liberty style. The URL must be a MapLibre-compatible style document and
# carries any provider key embedded (e.g.
# https://api.maptiler.com/maps/outdoor-v2/style.json?key=KEY). Classic
# Mapbox style URLs do NOT work — their mapbox:// sources/glyphs cannot be
# loaded by MapLibre; MAPBOX_ACCESS_TOKEN above stays for thumbnails only.
# MAP_STYLE_URL=
