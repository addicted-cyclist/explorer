<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Explorer" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <%= favicon_link_tag "explorer_logo.svg", type: "image/svg+xml" %>

    <!-- Design system fonts: Inter (type scale) + Material Symbols (iconography) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <%# App shell from design-refs/stitch_explorer_v0.2 route_upload_library_explorer
        (account dropdown added in v0.2) %>
    <header class="app-header">
      <div class="container app-header__inner">
        <div class="app-header__brand">
          <%= link_to user_signed_in? ? authenticated_root_path : unauthenticated_root_path, class: "brand-link" do %>
            <%= image_tag "explorer_logo.svg", alt: "Explorer logo", class: "brand-logo" %>
            <span class="brand-name">Explorer</span>
          <% end %>

          <% if user_signed_in? %>
            <nav class="app-nav" aria-label="Primary">
              <%= link_to "My Routes", routes_path,
                    class: class_names("app-nav__link", "app-nav__link--active" => controller_name == "routes"),
                    aria: { current: ("page" if controller_name == "routes") } %>
              <%= link_to "My calendar", calendar_path,
                    class: class_names("app-nav__link", "app-nav__link--active" => controller_name == "calendar"),
                    aria: { current: ("page" if controller_name == "calendar") } %>
              <%# TODO(phase-6+): Friends — no model/controller yet %>
              <a href="#" class="app-nav__link">Friends</a>
            </nav>
          <% end %>
        </div>

        <div class="app-header__actions">
          <% if user_signed_in? %>
            <%# TODO: theme toggle %>
            <div class="account-wrap" data-controller="dropdown">
              <button type="button" class="account-chip" data-dropdown-target="trigger"
                      data-action="dropdown#toggle" aria-haspopup="menu"
                      aria-expanded="false" aria-label="Account menu">
                <span class="account-chip__avatar">
                  <span class="material-symbols-outlined ms-18">person</span>
                </span>
                <span class="material-symbols-outlined ms-18 account-chip__chevron">expand_more</span>
              </button>

              <div class="account-menu" data-dropdown-target="menu" hidden role="menu">
                <div class="account-menu__header">
                  <p class="account-menu__user"><%= current_user.name.presence || current_user.email %></p>
                </div>
                <div class="account-menu__items">
                  <%= link_to account_path, class: "account-menu__item", role: "menuitem" do %>
                    <span class="material-symbols-outlined ms-18 account-menu__icon">account_circle</span>
                    <span>Account Settings</span>
                  <% end %>
                  <%= link_to destroy_user_session_path, data: { turbo_method: :delete },
                        class: "account-menu__item account-menu__item--danger", role: "menuitem" do %>
                    <span class="material-symbols-outlined ms-18 account-menu__icon">logout</span>
                    <span>Log out</span>
                  <% end %>
                </div>
              </div>
            </div>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "btn btn--ghost" %>
            <%= link_to "Sign up", new_user_registration_path, class: "btn btn--primary" %>
          <% end %>
        </div>
      </div>
    </header>

    <main class="app-main">
      <div class="container app-main__inner">
        <% if notice.present? %>
          <p class="flash flash--notice"><%= notice %></p>
        <% end %>
        <% if alert.present? %>
          <p class="flash flash--alert"><%= alert %></p>
        <% end %>
        <%= yield %>
      </div>
    </main>

    <footer class="app-footer">
      <div class="container app-footer__inner">
        <span class="app-footer__copy">© 2026 Explorer System Inc. All rights reserved.</span>
        <nav class="app-footer__nav" aria-label="Footer">
          <a href="#" class="app-footer__link">Contact</a>
          <a href="#" class="app-footer__link">Contribute</a>
          <a href="#" class="app-footer__link">API / Docs</a>
          <a href="#" class="app-footer__link">Terms</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
