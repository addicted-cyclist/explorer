<%# The toggled checkbox lives in a calendar day column: repaint just that
    column. @week_start / @week_entries / @entry are set by the controller. %>
<% if @entry %>
  <%= turbo_stream.replace calendar_day_dom_id(@entry.scheduled_on),
        partial: "calendars/day_column", locals: { date: @entry.scheduled_on } %>
<% end %>