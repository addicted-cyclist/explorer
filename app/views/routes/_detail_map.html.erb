<section class="route-detail__workspace">
  <div class="card route-detail__map">
    <header class="route-detail__map-head">
      <div class="route-detail__map-pill t-code-sm">
        <span class="route-detail__map-dot"></span>
        <span>gpx.studio embed</span>
      </div>
      <span class="route-detail__map-sub t-code-sm c-secondary">Interactive GPX Viewer &amp; Elevation Profile</span>
    </header>

    <%# TODO! remove allow="loopback-network" from iframe%>
    <% if gpx_studio_embed_src(@route) %>
      <iframe class="route-detail__map-frame"
              src="<%= gpx_studio_embed_src(@route) %>"
              title="Interactive GPX map — <%= @route.title %>"
              loading="lazy"
              allow="loopback-network"
              frameborder="0"
              style="outline: none;"></iframe>
    <% else %>
      <div class="route-detail__map-empty t-body-md c-secondary">
        <span class="material-symbols-outlined ms-18">map</span>
        <span>No GPX file is attached to this route, so there is no track to display.</span>
      </div>
    <% end %>
  </div>
</section>
