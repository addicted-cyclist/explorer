<%= turbo_frame_tag "modal" do %>
  <div class="modal is-open" data-controller="modal" data-modal-auto-open="true">
    <div class="modal__backdrop" data-action="click->modal#close" aria-hidden="true"></div>
    <div class="modal__card" role="dialog" aria-modal="true" aria-labelledby="edit-route-title">
      <header class="modal__head">
        <div>
          <h2 class="t-headline-sm" id="edit-route-title">Edit route details</h2>
          <p class="t-body-sm c-secondary">Name, description, difficulty and sport type</p>
        </div>
        <button type="button" class="icon-btn" data-action="modal#close" aria-label="Close dialog">
          <span class="material-symbols-outlined">close</span>
        </button>
      </header>

      <%= form_with model: @route, class: "modal__form" do |f| %>
        <%= render "devise/shared/error_messages", resource: @route %>

        <div class="field">
          <%= f.label :title, "Route name", class: "field-label" %>
          <%= f.text_field :title, class: "input", placeholder: "e.g. Feldberg crest loop" %>
        </div>

        <div class="field">
          <%= f.label :description, "Description", class: "field-label" %>
          <%= f.text_area :description, class: "input input--textarea", rows: 3,
                          placeholder: "Surface, highlights, planned stops…" %>
        </div>

        <div class="field-row">
          <div class="field">
            <%= f.label :tier, "Difficulty", class: "field-label" %>
            <%= f.select :tier, Route::TIERS.map { |tier| [tier, tier] },
                         { include_blank: "Unrated" }, class: "input" %>
          </div>
          <div class="field">
            <%= f.label :sport_type, "Sport type", class: "field-label" %>
            <%= f.text_field :sport_type, class: "input", placeholder: "Ride, gravel, hike…" %>
          </div>
        </div>

        <footer class="modal__actions">
          <button type="button" class="btn btn--ghost" data-action="modal#close">Cancel</button>
          <%= f.submit "Save changes", class: "btn btn--primary" %>
        </footer>
      <% end %>
    </div>
  </div>
<% end %>
