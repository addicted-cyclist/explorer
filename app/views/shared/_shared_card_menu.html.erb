<%# Kebab menu: complete toggle, edit dialog (Turbo Frame), delete.
    from_calendar/week (optional): routes the toggle/delete back to the week
    view, where toggle answers with a Turbo Stream day-column repaint. %>
<% calendar_context = local_assigns[:from_calendar].present? %>
<div class="card-menu" data-controller="dropdown">
  <button type="button" class="icon-btn" data-dropdown-target="trigger"
          data-action="dropdown#toggle" aria-label="Route actions" aria-expanded="false">
    <span class="material-symbols-outlined">more_vert</span>
  </button>
  <div class="card-menu__panel" data-dropdown-target="menu" hidden>
    <%= link_to download_route_path(route), class: "menu-item t-body-md", data: { turbo: false } do %>
      <span class="material-symbols-outlined">download</span>
      <span>Download GPX</span>
    <% end %>
    <% unless calendar_context %>
      <%= button_to toggle_completed_route_path(route), method: :patch, class: "menu-item t-body-md",
            params: (calendar_context ? { from_calendar: "1", week: local_assigns[:week] } : nil) do %>
        <span class="material-symbols-outlined"><%= route.completed? ? "radio_button_unchecked" : "check_circle" %></span>
        <span><%= route.completed? ? "Mark as not completed" : "Mark as completed" %></span>
      <% end %>
      <%= link_to edit_route_path(route), class: "menu-item t-body-md", data: { turbo_frame: "modal" } do %>
        <span class="material-symbols-outlined">edit</span>
        <span>Edit details</span>
      <% end %>
    <% end %>
    <%= button_to route_path(route), method: :delete, class: "menu-item menu-item--danger t-body-md",
                  params: (calendar_context ? { from_calendar: "1", week: local_assigns[:week] } : nil),
                  form: { data: { turbo_confirm: "Delete \"#{route.title}\"? This cannot be undone." } } do %>
      <span class="material-symbols-outlined">delete</span>
      <span>Delete route</span>
    <% end %>
  </div>
</div>
