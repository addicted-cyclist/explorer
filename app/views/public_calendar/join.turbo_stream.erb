<%# Repaint the shared entry card in its inert "Joined" state (public share
    view) — the public twin of calendars/join.turbo_stream.erb: same day
    column + mobile day panel contract. %>
<%= turbo_stream.replace dom_id(@entry),
      partial: "calendars/scheduled_entry", locals: { entry: @entry, joined: true } %>

<%# Mirror the repaint in the mobile day panel; its entry card derives the
    "Joined" dock state from @joined_origin_ids. %>
<%= turbo_stream.replace calendar_mobile_day_dom_id(@entry.scheduled_on),
      partial: "calendars/mobile/day_panel", locals: { date: @entry.scheduled_on } %>
