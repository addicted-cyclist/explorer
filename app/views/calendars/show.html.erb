<% content_for :title, @is_friend_view ? "#{@friend.name}'s calendar" : "My calendar" %>

<div class="wc">
  <% if @is_friend_view %>
    <nav class="wc__breadcrumb" aria-label="Breadcrumb">
      <%= link_to friends_path, class: "wc__breadcrumb-link t-label-md" do %>
        <span class="material-symbols-outlined ms-16" aria-hidden="true">arrow_back</span>
        <span>Back to Friends</span>
      <% end %>
      <span class="wc__badge t-label-md">
        <span class="material-symbols-outlined ms-14" aria-hidden="true">verified</span>
        <span>Friend view · read only</span>
      </span>
    </nav>
  <% end %>

  <header class="wc__header">
    <div class="wc__heading">
      <h1 class="t-headline-lg"><%= calendar_title %></h1>
      <p class="t-body-lg c-secondary library-hero__lede">
        <% if @is_friend_view %>
          Know where your friend goes
        <% else %>
          Make your weekly schedule and share it with your friends
        <% end %>
      </p>
    </div>
    <div class="wc__profile">
      <span class="wc__avatar t-label-lg" aria-hidden="true"><%= calendar_initials(@is_friend_view ? @friend : current_user) %></span>
      <div class="wc__profile-id">
        <p class="t-title-md"><%= @is_friend_view ? @friend.name : current_user.name %></p>
        <p class="t-body-sm c-tertiary">@<%= @is_friend_view ? @friend.username : current_user.username %></p>
      </div>
    </div>
  </header>

  <%= render "week_toolbar" %>

  <div class="wc__layout" data-controller="calendar-dnd">
    <%= render "calendar_sidebar" %>
    <section class="wc__main">
      <div class="wc__grid">
        <% (@week_start..(@week_start + 6)).each do |date| %>
          <%= render "day_column", date: date %>
        <% end %>
      </div>
      <%= render "telemetry_bar" %>
    </section>

    <%# Hidden forms the drag-and-drop controller fills and submits %>
    <% unless @is_friend_view %>
      <%= form_with url: allocate_calendar_path, method: :post, class: "wc-dnd-form",
            data: { calendar_dnd_target: "allocateForm" } do %>
        <%= hidden_field_tag :route_id, nil, id: "wc-dnd-route-id" %>
        <%= hidden_field_tag :scheduled_on, nil, id: "wc-dnd-scheduled-on" %>
        <%= hidden_field_tag :from_calendar, "1", id: "wc-dnd-from-calendar" %>
        <%= hidden_field_tag :week, @week_start.iso8601, id: "wc-dnd-week" %>
      <% end %>
      <%= form_with url: remove_entry_calendar_path, method: :delete, class: "wc-dnd-form",
            data: { calendar_dnd_target: "removeForm" } do %>
        <%= hidden_field_tag :route_id, nil, id: "wc-dnd-remove-route-id" %>
        <%= hidden_field_tag :from_calendar, "1", id: "wc-dnd-remove-from-calendar" %>
        <%= hidden_field_tag :week, @week_start.iso8601, id: "wc-dnd-remove-week" %>
      <% end %>
    <% end %>
  </div>

  <% unless @is_friend_view %>
    <%# Shared upload dialog behind the sidebar's "Import new GPX" CTA;
        week: makes the import land back on the visited week %>
    <%= render "shared/upload_modal", week: @week_start.iso8601 %>
  <% end %>
</div>

<%# Phase 8 — mobile weekly calendar: same data, rendered next to the
    desktop grid; CSS swaps the two layouts below 768px (see the .mob-wc
    section in application.css). The allocate / remove_entry / update_entry /
    join / toggle_completed streams repaint both layouts. %>
<%= render "calendars/mobile/show" %>
