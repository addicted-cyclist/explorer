<%# Phase 9 — "Share calendar" button (desktop) on my own calendar while
    the share is on: copies the public link to the clipboard with a short
    "Copied!" flash. The mobile header renders the native-share icon
    variant; the toggle itself lives in account settings. %>
<button type="button" class="btn wc-share-btn c-primary"
        data-controller="share-button"
        data-share-button-url-value="<%= public_calendar_url(current_user.public_token) %>"
        data-action="share-button#copy"
        aria-label="Copy public calendar link">
  <span class="material-symbols-outlined ms-18" aria-hidden="true">share</span>
  <span class="t-label-md" data-share-button-target="label">Share calendar</span>
</button>
