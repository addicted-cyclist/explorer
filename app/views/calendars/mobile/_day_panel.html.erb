<%# One mobile day: header, the day's entry cards (dot-nav slider when the
    day holds several) and the "Add route" tile. Repainted whole by the
    allocate / remove_entry / update_entry / toggle_completed / join Turbo
    Streams; mob-week re-applies the visible-day selection after each swap.
    initial_date seeds the server-rendered selection on full page loads —
    stream renders omit it, so the class simply stays off there. %>
<article class="mob-wc__panel<%= " is-selected" if date == local_assigns[:initial_date] %>"
         id="<%= calendar_mobile_day_dom_id(date) %>"
         data-mob-week-target="dayPanel" data-date="<%= date.iso8601 %>">
  <header class="mob-wc__panel-head">
    <h2 class="mob-wc__panel-name"><%= date.strftime("%A") %></h2>
    <p class="mob-wc__panel-date t-label-md c-secondary"><%= date.strftime("%-d %B %Y") %></p>
  </header>

  <% entries = calendar_day_entries(date) %>
  <% if entries.empty? %>
    <div class="mob-wc__empty">
      <span class="material-symbols-outlined mob-wc__empty-icon" aria-hidden="true">wb_sunny</span>
      <p class="mob-wc__empty-title">Rest day</p>
      <p class="mob-wc__empty-text t-body-md c-secondary">Nothing scheduled yet.</p>
    </div>
  <% elsif entries.size == 1 %>
    <%= render "calendars/mobile/entry_card", entry: entries.first %>
  <% else %>
    <div class="mob-wc__slider" data-controller="mob-slider">
      <div class="mob-wc__slider-track" data-mob-slider-target="track">
        <% entries.each do |entry| %>
          <div class="mob-wc__slider-slide"><%= render "calendars/mobile/entry_card", entry: entry %></div>
        <% end %>
      </div>
      <div class="mob-wc__slider-dots" role="tablist"
           aria-label="Routes on <%= date.strftime('%A') %>">
        <% entries.each_with_index do |entry, index| %>
          <button type="button" class="mob-wc__slider-dot"
                  data-mob-slider-target="dot" data-mob-slider-index-param="<%= index %>"
                  data-action="mob-slider#goTo"
                  aria-label="Route <%= index + 1 %> of <%= entries.size %>"></button>
        <% end %>
      </div>
    </div>
  <% end %>

  <% unless @is_friend_view %>
    <button type="button" class="mob-wc__addtile t-label-md"
            data-action="mob-sheet#open"
            data-mob-sheet-id-param="add-route"
            data-mob-sheet-date-param="<%= date.iso8601 %>">
      <span class="material-symbols-outlined ms-18" aria-hidden="true">add</span>
      <span>Add route</span>
    </button>
  <% end %>
</article>
