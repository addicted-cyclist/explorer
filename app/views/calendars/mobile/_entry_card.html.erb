<%# Scheduled entry card, Friends-card style, for the mobile day panel.
    My view: completed toggle + Remove. Friend view: read-only, with the
    Join ride button (or the inert Joined state, derived from
    @joined_origin_ids exactly like the desktop dock). Public share
    (Phase 9): like the friend card, and the join posts to the public join
    endpoint (guests are bounced to sign-in and returned here afterwards). %>
<% joined = local_assigns.fetch(:joined) { calendar_entry_joined?(entry) } %>
<%# Detail-link context: friends need username so the detail page's Calendar
    crumb returns to the friend week view; the share keeps just the week. %>
<% route_path_opts =
     if @is_friend_view
       { username: params[:username], week: params[:week] }
     else
       { week: params[:week] }
     end %>
<%# completion-confetti flips the completed class in place on check-submit
    and plays the celebration; the PATCH persists server-side (204). %>
<article class="mob-wc__entry<%= " mob-wc__entry--completed" if entry.completed? %>"
         id="<%= dom_id(entry, :mob_entry) %>"
         data-controller="completion-confetti">
  <div class="mob-wc__entry-header">
    <div class="mob-wc__entry-badges">
      <% if calendar_read_only? %>
        <span class="mob-wc__entry-status c-secondary" aria-hidden="true">
          <span class="material-symbols-outlined ms-16"><%= @is_public_view ? "public" : "groups" %></span>
        </span>
      <% else %>
        <%= button_to toggle_completed_calendar_path, method: :patch,
              class: "mob-wc__entry-check c-primary",
              params: { entry_id: entry.id, from_calendar: "1", week: (@week_start.iso8601 if @week_start) },
              aria: { label: entry.completed? ? "Mark as not completed" : "Mark as completed" } do %>
          <span class="material-symbols-outlined ms-16" aria-hidden="true">check</span>
        <% end %>
      <% end %>
      <span class="mob-wc__entry-tier t-label-sm t-uppercase <%= calendar_tier_class(entry.route.tier) %>">
        <%= entry.route.tier.presence || "Unrated" %>
      </span>
    </div>
    <div class="mob-wc__entry-actions">
      <% if @is_public_view %>
        <% if joined %>
          <span class="mob-wc__entry-joined t-label-md c-success">
            <span class="material-symbols-outlined ms-16" aria-hidden="true">check_circle</span>
            <span>Joined</span>
          </span>
        <% elsif user_signed_in? && entry.user_id == current_user.id %>
          <%# BUGS item 4: the share's origin owner — joining is blocked
              server-side, so the card shows the inert state instead. %>
          <span class="mob-wc__entry-joined t-label-md c-secondary">
            <span class="material-symbols-outlined ms-16" aria-hidden="true">person</span>
            <span>Your ride</span>
          </span>
        <% else %>
          <%= button_to public_calendar_join_path(params[:token], entry_id: entry.id, week: (@week_start.iso8601 if @week_start)),
                class: "btn btn--sm btn--primary mob-wc__entry-btn" do %>
            <span class="material-symbols-outlined ms-16" aria-hidden="true">group_add</span>
            <span class="t-label-sm">Join ride</span>
          <% end %>
        <% end %>
      <% elsif @is_friend_view %>
        <% if joined %>
          <span class="mob-wc__entry-joined t-label-md c-success">
            <span class="material-symbols-outlined ms-16" aria-hidden="true">check_circle</span>
            <span>Joined</span>
          </span>
        <% else %>
          <%= button_to join_calendar_path(entry_id: entry.id, week: (@week_start.iso8601 if @week_start)),
                class: "btn btn--sm btn--primary mob-wc__entry-btn" do %>
            <span class="material-symbols-outlined ms-16" aria-hidden="true">group_add</span>
            <span class="t-label-sm">Join ride</span>
          <% end %>
        <% end %>
      <% else %>
        <%= button_to remove_entry_calendar_path(entry_id: entry.id, from_calendar: "1",
                      week: (@week_start.iso8601 if @week_start)),
              method: :delete, class: "btn btn--sm btn--danger c-accent mob-wc__entry-btn",
              form: { data: { turbo_confirm: "Remove \"#{entry.route.title}\" from your calendar?" } } do %>
          <span class="material-symbols-outlined ms-16" aria-hidden="true">delete</span>
          <span class="t-label-sm">Remove</span>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="mob-wc__entry-info">
    <h3 class="t-title-md">
      <%= link_to entry.route.title, route_path(entry.route, **route_path_opts),
            class: "mob-wc__entry-link", title: entry.route.title %>
    </h3>
    <p class="mob-wc__entry-time t-label-sm c-secondary">
      <span class="material-symbols-outlined ms-16" aria-hidden="true">schedule</span>
      <span><%= entry.start_time&.strftime("%I:%M %p") || "--:--" %></span>
    </p>
  </div>

  <%= render "shared/card_metrics_n_thumb", route: entry.route, class_prefix: "mob-wc" %>
</article>
