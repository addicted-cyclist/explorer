<%# Bottom sheet: "Schedule {route}" — month grid + start time. mob-week
    renders the grid client-side (booked-day dots from the rendered week,
    same pattern as the detail page's calendar picker), fills the hidden
    route/date fields and re-enables the submit button. %>
<div class="mob-sheet" data-mob-sheet-target="sheet" data-sheet-id="schedule-route" aria-hidden="true">
  <div class="mob-sheet__panel" role="dialog" aria-modal="true" aria-labelledby="mob-sheet-schedule-title">
    <div class="mob-sheet__handle" aria-hidden="true"></div>

    <header class="mob-sheet__head">
      <div>
        <h2 class="t-title-lg" id="mob-sheet-schedule-title">Schedule route</h2>
        <p class="mob-sheet__subtitle t-label-md c-secondary">
          <span data-mob-sheet-target="field" data-field="routeTitle"
                data-field-fallback="Pick a route from your library">—</span>
        </p>
      </div>
      <button type="button" class="icon-btn mob-sheet__close" data-action="mob-sheet#close" aria-label="Close">
        <span class="material-symbols-outlined ms-18" aria-hidden="true">close</span>
      </button>
    </header>

    <%= form_with url: allocate_calendar_path, method: :post, class: "mob-sheet__form",
          data: { action: "turbo:submit-end->mob-week#onScheduleSubmitEnd turbo:submit-end->mob-sheet#onSubmitEnd" } do %>
      <%= hidden_field_tag :route_id, nil, id: "mob-schedule-route-id",
            data: { mob_sheet_target: "field", field: "routeId" } %>
      <%= hidden_field_tag :scheduled_on, nil, id: "mob-schedule-date",
            data: { mob_week_target: "scheduleDate" } %>
      <%= hidden_field_tag :from_calendar, "1", id: "mob-schedule-from-calendar" %>
      <%= hidden_field_tag :week, @week_start.iso8601, id: "mob-schedule-week" %>

      <div class="mob-sheet__calendar">
        <div class="calendar-popover__head">
          <span class="calendar-popover__month t-label-md" data-mob-week-target="monthLabel"></span>
          <div class="calendar-popover__nav">
            <button type="button" class="calendar-popover__nav-btn"
                    data-action="mob-week#shiftMonth" data-mob-week-delta-param="-1"
                    aria-label="Previous month">
              <span class="material-symbols-outlined ms-18">chevron_left</span>
            </button>
            <button type="button" class="calendar-popover__nav-btn"
                    data-action="mob-week#shiftMonth" data-mob-week-delta-param="1"
                    aria-label="Next month">
              <span class="material-symbols-outlined ms-18">chevron_right</span>
            </button>
          </div>
        </div>
        <div class="calendar-weekdays t-code-sm c-tertiary">
          <% %w[Su Mo Tu We Th Fr Sa].each do |weekday| %>
            <span><%= weekday %></span>
          <% end %>
        </div>
        <div class="mob-sheet__grid" data-mob-week-target="monthGrid"></div>
      </div>

      <label class="mob-sheet__field">
        <span class="t-label-md c-secondary">Start time</span>
        <%= select_tag :start_time, options_for_select(calendar_start_time_options, "08:00"),
              id: "mob-schedule-start-time", class: "input t-body-md", aria: { label: "Start time" } %>
      </label>

      <footer class="mob-sheet__actions">
        <button type="button" class="btn btn--ghost" data-action="mob-sheet#close">Cancel</button>
        <button type="submit" class="btn btn--primary" data-mob-week-target="scheduleSubmit" disabled>
          Schedule Route
        </button>
      </footer>
    <% end %>
  </div>
</div>
