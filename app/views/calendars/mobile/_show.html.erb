<%# Phase 8 — Mobile weekly calendar ("My & friend calendar"). Rendered on
    every calendar page next to the desktop .wc layout; CSS swaps the two
    below 768px (no separate route). Day state lives in mob-week, bottom
    sheets in mob-sheet, the swipe slider in mob-slider; the allocate /
    remove_entry / update_entry / join Turbo Streams repaint both layouts. %>
<% week_dates = (@week_start..(@week_start + 6)).to_a %>
<% initial_date = calendar_mobile_initial_date %>
<section class="mob-wc"
         data-controller="mob-week mob-sheet"
         data-action="mob-sheet:closed->mob-week#onSheetClosed"
         data-mob-week-initial-date-value="<%= initial_date.iso8601 %>"
         data-mob-week-booked-dates-value="<%= calendar_booked_dates_json %>"
         data-mob-week-initial-month-value="<%= @week_start.iso8601 %>"
         data-mob-sheet-open-class="is-open"
         data-mob-sheet-locked-class="mob-sheet--locked">

  <header class="mob-wc__header">
    <div class="mob-wc__heading">
      <h1 class="t-headline-md"><%= calendar_title %></h1>
      <p class="mob-wc__subtitle t-body-sm c-secondary">
        <% if @is_friend_view %>
          Know where your friend goes
        <% elsif @is_public_view %>
          A training week shared with you
        <% else %>
          Make your weekly schedule and share it with your friends
        <% end %>
      </p>
    </div>
    <%# Phase 9 — native-share icon on my own calendar while the share is on
        (the toggle lives in account settings); visitors never see it. %>
    <% if !calendar_read_only? && current_user.calendar_public? %>
      <button type="button" class="mob-wc__share"
              data-controller="share-button"
              data-share-button-url-value="<%= public_calendar_url(current_user.public_token) %>"
              data-share-button-title-value="<%= calendar_title %>"
              data-action="share-button#share"
              aria-label="Share my public calendar">
        <span class="material-symbols-outlined ms-20" aria-hidden="true">share</span>
      </button>
    <% end %>
    <span class="mob-wc__avatar t-label-lg" aria-hidden="true">
      <%= calendar_initials(calendar_view_user) %>
    </span>
  </header>

  <div id="mob-week-kpi-container">
    <%= render "calendars/mobile/kpis" %>
  </div>

  <div class="mob-wc__weeknav">
    <%= link_to calendar_week_path_for(@week_start - 7), class: "mob-wc__weeknav-btn",
                aria: { label: "Previous week" } do %>
      <span class="material-symbols-outlined ms-18" aria-hidden="true">chevron_left</span>
    <% end %>
    <span class="mob-wc__weeknav-label t-label-md"><%= calendar_week_label_short(@week_start) %></span>
    <%= link_to calendar_week_path_for(@week_start + 7), class: "mob-wc__weeknav-btn",
                aria: { label: "Next week" } do %>
      <span class="material-symbols-outlined ms-18" aria-hidden="true">chevron_right</span>
    <% end %>
  </div>

  <%# Swipeable day strip: one pill per day with the planned kilometres. %>
  <div class="mob-wc__strip" id="mob-wc-strip" role="tablist" aria-label="Days of the week">
    <%= render "calendars/mobile/days-strip" %>
  </div>

  <%# One panel per day; mob-week shows the selected one. Each panel carries
      its own id so the Turbo Streams can repaint a single day. %>
  <section class="mob-wc__schedule" aria-label="Day schedule">
    <% week_dates.each do |date| %>
      <%= render "calendars/mobile/day_panel", date: date, initial_date: initial_date %>
    <% end %>
  </section>

  <section class="mob-wc__routes" aria-label="Route library">
    <header class="mob-wc__routes-head">
      <h2 class="t-headline-sm">
        <%= calendar_read_only? ? "#{calendar_short_name(calendar_view_user)}'s week" : "My routes" %>
      </h2>
      <span class="t-label-sm c-secondary">
        <%= pluralize(@sidebar_routes.size, "route") %>
      </span>
    </header>
    <div class="mob-wc__routes-list">
      <% if @sidebar_routes.empty? %>
        <p class="mob-wc__routes-empty t-body-md c-secondary">
          <%= calendar_read_only? ? "No routes scheduled this week." : "No routes yet — upload a GPX to start planning." %>
        </p>
      <% else %>
        <% @sidebar_routes.each do |route| %>
          <%= render "calendars/mobile/route_card", route: route %>
        <% end %>
      <% end %>
    </div>
  </section>

  <% unless calendar_read_only? %>
    <%= render "calendars/mobile/sheet_add_route" %>
    <%= render "calendars/mobile/sheet_schedule_route" %>
  <% end %>

  <%# Shared scrim behind whichever sheet is open. %>
  <div class="mob-sheet__backdrop" data-mob-sheet-target="backdrop"
       data-action="click->mob-sheet#close" aria-hidden="true"></div>
</section>
