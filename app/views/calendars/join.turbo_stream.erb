<%# Repaint the friend's entry card: its dock swaps to the inert "Joined"
    button via the joined local on the partial (no popover afterwards). %>
<%= turbo_stream.replace dom_id(@entry),
      partial: "scheduled_entry", locals: { entry: @entry, joined: true } %>

<%# Phase 8: mirror the repaint in the mobile day panel (friend view); its
    entry card derives the "Joined" dock state from @joined_origin_ids. %>
<%= turbo_stream.replace calendar_mobile_day_dom_id(@entry.scheduled_on),
      partial: "calendars/mobile/day_panel", locals: { date: @entry.scheduled_on } %>
