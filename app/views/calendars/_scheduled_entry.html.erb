<article class="wc-entry<%= " wc-entry--completed" if entry.route.completed? %>"
         id="<%= dom_id(entry) %>"
         data-controller="entry-time-editor">
  <header class="wc-entry__head">
    <div class="wc-entry__id">
      <span class="wc-entry__time t-label-md">
        <span class="material-symbols-outlined ms-14" aria-hidden="true">schedule</span>
        <%= entry.start_time&.strftime("%H:%M") || "--:--" %>
      </span>
      <h4 class="wc-entry__title t-title-md">
        <%= link_to entry.route.title, route_path(entry.route), class: "wc-entry__link" %>
      </h4>
    </div>
    <% if @is_friend_view %>
      <% if local_assigns[:joined] %>
        <span class="wc-join wc-join--joined t-label-sm" title="A copy of this route is on your calendar">
          <span class="material-symbols-outlined ms-16" aria-hidden="true">check_circle</span>
          <span>Joined</span>
        </span>
      <% else %>
        <%= render "calendars/join_popover", entry: entry %>
      <% end %>
    <% else %>
      <div class="wc-entry__actions">
        <button type="button" class="icon-btn"
                aria-label="Edit start time"
                data-action="entry-time-editor#open">
          <span class="material-symbols-outlined" aria-hidden="true">edit_clock</span>
        </button>
        <button type="button" class="icon-btn"
                aria-label="Remove from calendar"
                title="Drag off the calendar to unschedule"
                data-action="calendar-dnd#removeEntry"
                data-route-id="<%= entry.route_id %>">
          <span class="material-symbols-outlined" aria-hidden="true">drag_pan</span>
        </button>
      </div>
    <% end %>
  </header>

  <div class="wc-entry__metrics t-label-sm">
    <span><span class="material-symbols-outlined ms-14" aria-hidden="true">straighten</span> <%= format_distance(entry.route.distance) %> km</span>
    <span><span class="material-symbols-outlined ms-14" aria-hidden="true">north_east</span> <%= format_elevation(entry.route.elevation_gain) %> m</span>
    <span><span class="material-symbols-outlined ms-14" aria-hidden="true">timer</span> <%= format_duration(entry.route.duration) %></span>
  </div>

  <% if entry.route.completed? %>
    <span class="wc-entry__done t-label-sm">
      <span class="material-symbols-outlined ms-14" aria-hidden="true">check_circle</span>
      <span>Completed</span>
    </span>
  <% end %>

  <% unless @is_friend_view %>
    <div data-entry-time-editor-target="editor" data-action="turbo:submit-end->entry-time-editor#onSubmitEnd" hidden>
      <%= form_with url: update_entry_calendar_path, method: :patch, class: "wc-entry__editor",
            data: { entry_time_editor_target: "form" } do |form| %>
        <%= hidden_field_tag :entry_id, entry.id, id: "wc-entry-id-#{entry.id}" %>
        <%= hidden_field_tag :from_calendar, "1", id: "wc-entry-from-cal-#{entry.id}" %>
        <%= hidden_field_tag :week, (@week_start.iso8601 if @week_start), id: "wc-entry-week-#{entry.id}" %>
        <%= form.label :start_time, "Start time", class: "sr-only", for: "wc-entry-start-#{entry.id}" %>
        <%= select_tag :start_time,
              options_for_select(calendar_start_time_options, entry.start_time&.strftime("%H:%M")),
              id: "wc-entry-start-#{entry.id}",
              class: "input t-body-md",
              aria: { label: "Start time" },
              data: { entry_time_editor_target: "input" } %>
        <button type="submit" class="btn btn--sm btn--primary">
          <span class="material-symbols-outlined ms-16" aria-hidden="true">check</span>
          <span class="t-label-sm">Save</span>
        </button>
      <% end %>
    </div>
  <% else %>
    <% if local_assigns[:joined] %>
      <p class="wc-entry__joined-note t-body-sm c-secondary">A copy of this ride is on your calendar.</p>
    <% end %>
  <% end %>
</article>
