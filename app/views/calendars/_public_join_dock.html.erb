<%# "Join" dock control on a public share's scheduled ride — the popover-less
    cousin of the friend view's join popover. Unjoined: a direct join button
    (guests are bounced to sign-in and returned here afterwards; signed-in
    visitors stay on the page while the join Turbo Stream repaints). Joined:
    the inert green "Joined" state, no interaction. %>
<% if local_assigns[:joined] %>
  <button type="button" class="wc-join__btn wc-join--joined t-label-sm c-success" disabled>
    <span class="material-symbols-outlined ms-16" aria-hidden="true">check</span>
    <span>Joined</span>
  </button>
<% else %>
  <%= button_to public_calendar_join_path(params[:token], entry_id: entry.id, week: (@week_start.iso8601 if @week_start)),
        class: "wc-join__btn t-label-sm c-primary",
        aria: { label: "Add this ride to my calendar" } do %>
    <span class="material-symbols-outlined ms-16" aria-hidden="true">add_circle</span>
    <span>Join</span>
  <% end %>
<% end %>
