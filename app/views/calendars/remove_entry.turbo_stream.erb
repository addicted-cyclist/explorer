<% if @removed_date %>
  <%= turbo_stream.replace calendar_day_dom_id(@removed_date),
        partial: "day_column", locals: { date: @removed_date } %>
<% end %>

<%= turbo_stream.replace "wc-telemetry", partial: "telemetry_bar" %>

<%# Phase 8: mirror the repaint in the mobile layout. %>
<% if @removed_date %>
  <%= turbo_stream.replace calendar_mobile_day_dom_id(@removed_date),
        partial: "calendars/mobile/day_panel", locals: { date: @removed_date } %>
<% end %>

<%= turbo_stream.update "mob-week-kpi-container", partial: "calendars/mobile/kpis" %>

<%= turbo_stream.update "mob-wc-strip", partial: "calendars/mobile/days-strip" %>

<%# The routes pages' add-to-calendar picker (library card icon / detail
    chip) repaints from fresh state after the destroy. A no-op on pages
    without the picker, e.g. the calendar grid. %>
<% if @picker_route %>
  <%= turbo_stream.replace dom_id(@picker_route, :calendar_picker),
        partial: "routes/detail_calendar",
        locals: { route: @picker_route, calendar_entry: @picker_entry,
                  route_card: params[:picker_mode] == "card" } %>
<% end %>
