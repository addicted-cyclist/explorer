<%# One library route in the calendar sidebar. My view: draggable pool card
    with the shared kebab menu (wired back to the week view). Friend view:
    read-only card with a GPX download button. Public share (Phase 9): like
    the friend card, but titles are plain text (route detail pages stay
    auth-gated) and downloads ride the signed-id GPX endpoint. %>
<% readonly = calendar_read_only? %>
<article class="wc-route-card<%= " wc-route-card--friend" if readonly %>"
         id="<%= dom_id(route, :wc_sidebar) %>"
         data-search="<%= [route.title, route.sport_type, route.tier].compact.join(" ") %>"
         data-distance="<%= route.distance.to_f %>"
         draggable="<%= readonly ? "false" : "true" %>"
         <%= tag.attributes(data: { calendar_dnd_id_param: route.id, action: "dragstart->calendar-dnd#dragStart dragend->calendar-dnd#dragEnd" }) unless readonly %>>
  <header class="wc-route-card__head">
    <% if @is_public_view %>
      <h3 class="wc-route-card__title t-title-md">
        <span class="c-primary" title="<%= route.title %>"><%= route.title %></span>
      </h3>
      <% if route.gpx_file.attached? %>
        <%= link_to calendar_public_gpx_path(route), class: "wc-gpx-btn c-secondary", title: "Download GPX", data: { turbo: false } do %>
          <span class="material-symbols-outlined ms-16" aria-hidden="true">download</span>
          <span class="t-label-sm">GPX</span>
        <% end %>
      <% end %>
    <% elsif @is_friend_view %>
      <h3 class="wc-route-card__title t-title-md">
        <%= link_to route.title, route_path(route), class: "c-primary" %>
      </h3>
      <%= link_to download_route_path(route), class: "wc-gpx-btn c-secondary", title: "Download GPX", data: { turbo: false } do %>
        <span class="material-symbols-outlined ms-16" aria-hidden="true">download</span>
        <span class="t-label-sm">GPX</span>
      <% end %>
    <% else %>
      <h3 class="wc-route-card__title t-title-md">
        <%= link_to route.title, route_path(route), class: "c-primary" %>
      </h3>
      <%= render "shared/shared_card_menu", route: route, from_calendar: true, week: @week_start.iso8601 %>
    <% end %>
  </header>

  <%# Phase 0 capacity: the card body (tier, track SVG, metrics) is a pure
      function of the route and identical across my / friend / public views —
      cached per route and shared by every viewer. The head above stays
      uncached: it branches per view mode and carries the kebab menu whose
      button_to forms embed session-scoped CSRF tokens. %>
  <% cache(wc_sidebar_body_cache_key(route)) do %>
    <span class="wc-route-card__tier t-label-sm t-uppercase <%= calendar_tier_class(route.tier) %>"><%= route.tier.presence || "Unrated" %></span>

    <div class="wc-route-card__thumb">
      <% if route.track_svg.present? %>
        <svg class="wc-route-card__track" viewBox="<%= Route::TRACK_SVG_VIEWBOX %>"
             preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
          <path d="<%= route.track_svg %>"></path>
        </svg>
      <% else %>
        <div class="wc-route-card__thumb-fallback c-tertiary">
          <span class="material-symbols-outlined" aria-hidden="true">route</span>
        </div>
      <% end %>
    </div>

    <footer class="wc-route-card__metrics t-label-sm c-secondary">
      <span class="wc-route-card__metric"><span class="material-symbols-outlined ms-14" aria-hidden="true">straighten</span><span><%= format_distance(route.distance) %> km</span></span>
      <span class="wc-route-card__metric"><span class="material-symbols-outlined ms-14" aria-hidden="true">north_east</span><span><%= format_elevation(route.elevation_gain) %> m</span></span>
      <span class="wc-route-card__metric"><span class="material-symbols-outlined ms-14" aria-hidden="true">timer</span><span><%= format_duration(route.duration) %></span></span>
    </footer>
  <% end %>
</article>
