<% content_for :title, "My Map" %>
<%# My Map (technote.MYMAP-FEATURE.md + design-refs/stitch_explorer_v0.14).
    Full-bleed map workspace: sub-bar (location chip, scope pills, disabled
    "draw" affordance), the MapLibre canvas, the floating routes drawer and
    the selected-route popup. The my-map controller owns all data flow — the
    markup below is only skeleton + templates. %>
<% content_for :full_width, true %>
<%# The workspace fills the viewport under the sub-bar (layout drops the
    footer for this page), so the page itself never scrolls — horizontally
    or otherwise: the stage takes exactly the remaining height. %>
<% content_for :hide_footer, true %>

<div class="mymap"
     data-controller="my-map"
     data-my-map-config-value="<%= map_frontend_config.to_json %>"
     data-my-map-own-url-value="<%= own_map_routes_path %>"
     data-my-map-public-url-value="<%= public_map_routes_path %>"
     data-my-map-recommendations-url-value="<%= recommendations_map_routes_path %>"
     data-my-map-place-label-url-value="<%= map_place_label_path %>"
     data-my-map-thumb-post-url-template-value="<%= static_map_route_path("__ROUTE_ID__") %>"
     <%# "Find new routes" sport categories (key + label) straight from
         Map::RouteFinder::SPORT_CATEGORIES — the drawer's filter chips label
         themselves from this list instead of a duplicated JS map. %>
     data-my-map-sports-value="<%= find_sport_categories.to_json %>"
     <%# The most-ridden place ([w, s, e, n]) computed server-side from the
         whole own-routes library — own routes load per viewport now, so the
         client can no longer derive it. "[]" when no parsed routes exist;
         the controller then falls back to persisted → geolocation → default. %>
     data-my-map-hotspot-bounds-value="<%= Array(@own_hotspot_bounds).to_json %>"
     <%# Route Planner (technote.ROUTE-DRAW.md): the three HTTP doors the
         planner module uses — segment calculation, editor save and the POI
         image upload. All POST to PlannerController behind the session. %>
     data-my-map-planner-calculate-url-value="<%= planner_calculate_path %>"
     data-my-map-planner-save-url-value="<%= planner_save_path %>"
     data-my-map-planner-poi-image-url-value="<%= planner_poi_images_path %>"
     <%# GET template for one route's editor boot state (§2.2): the popup's
         Edit affordance fetches it and boots the planner in place — no page
         reload. The /map?edit=ID href below stays as the no-JS fallback and
         the deep-link/refresh entry. %>
     data-my-map-planner-state-url-template-value="<%= planner_state_path("__ROUTE_ID__") %>"
     data-my-map-popup-edit-url-template-value="<%= map_path(edit: "__ROUTE_ID__") %>"
     <%# §2.2 Edit existing route: the server-rendered editor state (RWs, SPs,
         POIs, profile, segments) when the page was opened via /map?edit=ID —
         "{}" for a fresh planner. %>
     data-my-map-edit-state-value="<%= (@planner_state || {}).to_json %>">

  <div class="mymap__subbar">
    <div class="mymap__subbar-inner">
      <%# Location chip: the server-rendered default is the fallback; the
          my-map controller rewrites it from the reverse geocoder
          (MapsController#place_label → Photon) as the viewport moves. %>
      <div class="mymap__location">
        <span class="material-symbols-outlined mymap__location-pin" aria-hidden="true">location_on</span>
        <span class="mymap__location-label" data-my-map-target="locationLabel"><%= map_frontend_config[:defaultPlaceLabel] %></span>
      </div>
      <div class="mymap__subbar-actions">
        <div class="mymap__scope" role="group" aria-label="Filter map routes">
          <button type="button" class="mymap__scope-pill is-active"
                  data-my-map-target="scopePill" data-scope="all"
                  data-action="my-map#setScope">All (<span data-my-map-target="allCount">0</span>)</button>
          <button type="button" class="mymap__scope-pill"
                  data-my-map-target="scopePill" data-scope="own"
                  data-action="my-map#setScope">My Routes (<span data-my-map-target="ownCount">0</span>)</button>
          <button type="button" class="mymap__scope-pill"
                  data-my-map-target="scopePill" data-scope="public"
                  data-action="my-map#setScope">Public (<span data-my-map-target="publicCount">0</span>)</button>
        </div>
        <%# Route Planner mode indicators (design-refs/stitch_explorer_v.0.15):
            while planning, the scope pills swap for the drawing-mode chip and
            an Exit button; CSS on .mymap--planning toggles the pieces. %>
        <div class="mymap__drawing-chip" data-my-map-target="drawingChip" hidden>
          <span class="mymap__drawing-dot" aria-hidden="true"></span>
          <span>Drawing Mode: Click map to place waypoints</span>
        </div>
        <button type="button" class="mymap__draw btn btn--secondary"
                title="Draw a new route on the map"
                data-action="my-map#enterPlanner">
          <span class="material-symbols-outlined" aria-hidden="true">gesture</span>
          <span class="mymap__draw-label">Draw new route</span>
        </button>
        <button type="button" class="mymap__exit btn btn--secondary"
                title="Exit the route planner"
                data-action="my-map#exitPlanner" data-my-map-target="exitButton" hidden>
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
          <span class="mymap__draw-label">Exit</span>
        </button>
        <%# "Find new routes" (design-refs/stitch_explorer_v0.14): opens the
            filter modal below. Two hooks share the click — my-map#openFindRoutes
            syncs the modal inputs to the active filters, the generic overlay
            controller opens via data-modal-open. %>
        <button type="button" class="mymap__find btn btn--primary"
                title="Find new routes nearby"
                data-action="my-map#openFindRoutes"
                data-modal-open="find-routes"
                data-my-map-target="findButton">
          <span class="material-symbols-outlined" aria-hidden="true">filter_arrow_right</span>
          <span class="mymap__find-label">Find new routes</span>
        </button>
      </div>
    </div>
  </div>

  <div class="mymap__stage" data-my-map-target="stage">
    <div class="mymap__canvas" data-my-map-target="canvas"
         aria-label="Map of your routes and public routes"></div>

    <aside class="mymap-drawer" data-my-map-target="drawer" aria-label="Routes on the map">
      <header class="mymap-drawer__head">
        <div class="mymap-drawer__icon">
          <span class="material-symbols-outlined" aria-hidden="true">route</span>
        </div>
        <div class="mymap-drawer__titles">
          <h2 class="mymap-drawer__title">Found Routes</h2>
          <p class="mymap-drawer__count"><span data-my-map-target="drawerCount">0</span> <span data-my-map-target="drawerCountNote">routes on the map</span></p>
        </div>
        <button type="button" class="mymap-drawer__toggle"
                data-my-map-target="drawerToggle"
                data-action="my-map#toggleDrawer"
                aria-label="Collapse routes panel" title="Collapse panel">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </header>
      <%# Active-filter chips row (find-routes match mode only; hidden in the
          normal viewport drawer). The my-map controller builds the chips, the
          Edit shortcut and the Clear × from text nodes. %>
      <div class="mymap-drawer__filters" data-my-map-target="filterChips" hidden></div>
      <div class="mymap-drawer__list" data-my-map-target="cardList"></div>
      <p class="mymap-drawer__empty t-body-sm c-secondary" data-my-map-target="drawerEmpty" hidden>
        No routes to show yet. Upload GPX files in My Routes, or pan the map
        to discover public routes from other riders.
      </p>
    </aside>

    <%# Selected-route popup (v0.14 right-hand card): ownership/visibility
        badge, title, blurb, stat tiles, elevation profile and the two
        actions. All fields are filled by the my-map controller from the
        selected feature's properties. %>
    <aside class="mymap-popup" data-my-map-target="popup" hidden aria-label="Selected route details">
      <div class="mymap-popup__badge-row">
        <span class="mymap-popup__dot" data-my-map-target="popupDot" aria-hidden="true"></span>
        <span class="mymap-popup__badge" data-my-map-target="popupBadge">Your route</span>
        <button type="button" class="mymap-popup__close" data-action="my-map#closePopup"
                aria-label="Close route preview" title="Close">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </div>

      <h3 class="mymap-popup__title" data-my-map-target="popupTitle"></h3>
      <p class="mymap-popup__description t-body-sm c-secondary" data-my-map-target="popupDescription" hidden></p>

      <div class="mymap-popup__stats">
        <div class="mymap-popup__stat">
          <div class="mymap-popup__stat-icon">
            <span class="material-symbols-outlined" aria-hidden="true">straighten</span>
          </div>
          <div class="mymap-popup__stat-text">
            <span class="mymap-popup__stat-label">Distance</span>
            <span class="mymap-popup__stat-value" data-my-map-target="popupDistance">&mdash;</span>
          </div>
        </div>
        <div class="mymap-popup__stat">
          <div class="mymap-popup__stat-icon">
            <span class="material-symbols-outlined" aria-hidden="true">north_east</span>
          </div>
          <div class="mymap-popup__stat-text">
            <span class="mymap-popup__stat-label">Elev gain</span>
            <span class="mymap-popup__stat-value" data-my-map-target="popupElevation">&mdash;</span>
          </div>
        </div>
        <div class="mymap-popup__stat">
          <div class="mymap-popup__stat-icon">
            <span class="material-symbols-outlined" aria-hidden="true">speed</span>
          </div>
          <div class="mymap-popup__stat-text">
            <span class="mymap-popup__stat-label">Avg speed</span>
            <span class="mymap-popup__stat-value" data-my-map-target="popupSpeed">&mdash;</span>
          </div>
        </div>
        <div class="mymap-popup__stat">
          <div class="mymap-popup__stat-icon">
            <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
          </div>
          <div class="mymap-popup__stat-text">
            <span class="mymap-popup__stat-label">Est. moving</span>
            <span class="mymap-popup__stat-value" data-my-map-target="popupDuration">&mdash;</span>
          </div>
        </div>
      </div>

      <div class="mymap-popup__profile" data-my-map-target="profileBlock" hidden>
        <div class="mymap-popup__profile-head">
          <span class="mymap-popup__profile-label">Elevation profile</span>
          <span class="mymap-popup__profile-max">Max: <span data-my-map-target="profileMax"></span></span>
        </div>
        <svg class="mymap-popup__profile-chart" viewBox="0 0 300 80" preserveAspectRatio="none"
             aria-hidden="true" data-my-map-target="profileChart">
          <path class="mymap-popup__profile-area" data-my-map-target="profileArea" d=""></path>
          <path class="mymap-popup__profile-line" data-my-map-target="profileLine" d=""></path>
          <circle class="mymap-popup__profile-marker" r="3" data-my-map-target="profileMarker"></circle>
        </svg>
        <div class="mymap-popup__profile-axis t-code-sm c-tertiary">
          <span>0 km</span>
          <span data-my-map-target="profileMid"></span>
          <span data-my-map-target="profileEnd"></span>
        </div>
      </div>

      <div class="mymap-popup__actions">
        <%= link_to "#", class: "btn btn--primary mymap-popup__open",
                    data: { my_map_target: "popupLink" } do %>
          <span>Open Route Details</span>
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        <% end %>
        <%# Route Planner entry (§2.2): own routes only — the controller
            unhides this and points it at /map?edit=ID. %>
        <%= link_to "#", class: "mymap-popup__edit", title: "Edit route in the planner",
                    aria: { label: "Edit route in the planner" },
                    data: { my_map_target: "popupEdit", turbo: false } do %>
          <span class="material-symbols-outlined" aria-hidden="true">edit</span>
        <% end %>
        <%= link_to "#", class: "mymap-popup__download", title: "Download GPX",
                    aria: { label: "Download GPX" }, data: { my_map_target: "popupDownload" } do %>
          <span class="material-symbols-outlined" aria-hidden="true">download</span>
        <% end %>
      </div>

      <%# Touch layout (phones): the card above collapses to this floating
          bar — a small rounded black "Route details" jump plus a deselect ×.
          The rich card stays in the DOM for desktop/tablet; CSS swaps the
          two presentations at the popup's mobile breakpoint. %>
      <div class="mymap-popup__mobile-bar">
        <%= link_to "#", class: "mymap-popup__mobile-cta",
                    data: { my_map_target: "popupMobileLink" } do %>
          <span>Route details</span>
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        <% end %>
        <button type="button" class="mymap-popup__mobile-close" data-action="my-map#closePopup"
                aria-label="Close route preview">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </div>
    </aside>

    <%# Live data state (design's bottom-left pill): counts plus loading /
        error feedback. Clicking an errored pill retries the viewport fetch. %>
    <button type="button" class="mymap-status t-body-sm" data-my-map-target="status"
            data-action="my-map#retry" hidden></button>
    <%# Route Planner (technote.ROUTE-DRAW.md + design-refs/stitch_explorer_
        v.0.15): the left editor panel. Skeleton only — the route_planner
        module (instantiated by my-map) owns every interaction, recalculation
        and the POI modal; the data-planner hooks below are its DOM contract. %>
    <aside class="mymap-planner" data-my-map-target="plannerPanel" hidden aria-label="Route planner">
      <header class="mymap-planner__head">
        <span class="mymap-planner__badge"><span class="mymap-planner__badge-dot" aria-hidden="true"></span>DRAFT</span>
        <button type="button" class="mymap-planner__close" data-planner="close" aria-label="Close the route planner" title="Close">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </header>

      <div class="mymap-planner__name">
        <label class="visually-hidden" for="planner-route-name">Route name</label>
        <span class="material-symbols-outlined mymap-planner__name-icon" aria-hidden="true">edit</span>
        <input type="text" id="planner-route-name" class="mymap-planner__name-input" data-planner="title"
               placeholder="Name your route" maxlength="200" autocomplete="off">
      </div>

      <div class="mymap-planner__section-label t-label-sm c-tertiary">ROUTING MODE</div>
      <div class="mymap-planner__modes" role="radiogroup" aria-label="Routing profile">
        <button type="button" class="mymap-planner__mode" data-planner="profile" data-profile="road">
          <span class="material-symbols-outlined" aria-hidden="true">pedal_bike</span>
          <span>Road</span>
        </button>
        <button type="button" class="mymap-planner__mode" data-planner="profile" data-profile="gravel">
          <span class="material-symbols-outlined" aria-hidden="true">landscape</span>
          <span>Gravel</span>
        </button>
        <button type="button" class="mymap-planner__mode" data-planner="profile" data-profile="mtb">
          <span class="material-symbols-outlined" aria-hidden="true">forest</span>
          <span>MTB</span>
        </button>
      </div>

      <div class="mymap-planner__tools" role="group" aria-label="Route actions">
        <button type="button" class="mymap-planner__tool" data-planner="undo" title="Undo (Ctrl+Z)" aria-label="Undo" disabled>
          <span class="material-symbols-outlined" aria-hidden="true">undo</span>
        </button>
        <button type="button" class="mymap-planner__tool" data-planner="redo" title="Redo (Ctrl+Shift+Z)" aria-label="Redo" disabled>
          <span class="material-symbols-outlined" aria-hidden="true">redo</span>
        </button>
        <button type="button" class="mymap-planner__tool mymap-planner__tool--wide" data-planner="reverse" title="Reverse direction">
          <span class="material-symbols-outlined" aria-hidden="true">swap_horiz</span>
          <span>Reverse</span>
        </button>
        <button type="button" class="mymap-planner__tool mymap-planner__tool--wide" data-planner="loop" title="Close the loop">
          <span class="material-symbols-outlined" aria-hidden="true">all_inclusive</span>
          <span data-planner="loop-label">Close Loop</span>
        </button>
        <button type="button" class="mymap-planner__tool mymap-planner__tool--danger" data-planner="clear" title="Clear route">
          <span class="material-symbols-outlined" aria-hidden="true">delete</span>
        </button>
      </div>

      <div class="mymap-planner__section-row">
        <span class="mymap-planner__section-label t-label-sm c-tertiary">PLOTTED WAYPOINTS</span>
        <%# §7: POIs never affect routing — placed with a next-map-click tool,
            then given their metadata in the POI modal. %>
        <button type="button" class="mymap-planner__add-poi" data-planner="add-poi"
                title="Add a point of interest on the next map click">
          <span class="material-symbols-outlined" aria-hidden="true">flag</span>
          <span>POI</span>
        </button>
      </div>
      <div class="mymap-planner__list" data-planner="waypoint-list" role="list"></div>
      <p class="mymap-planner__list-hint t-body-sm c-tertiary" data-planner="list-hint">
        Click the map to place your first waypoint.
      </p>

      <div class="mymap-planner__profile" data-planner="profile-block" hidden>
        <div class="mymap-planner__profile-head">
          <span class="mymap-planner__profile-label t-label-md">LIVE ALTITUDE PROFILE</span>
          <span class="mymap-planner__profile-max t-code-sm c-tertiary" data-planner="profile-max"></span>
        </div>
        <svg class="mymap-planner__profile-chart" viewBox="0 0 300 56" preserveAspectRatio="none" aria-hidden="true">
          <path class="mymap-planner__profile-area" data-planner="profile-area" d=""></path>
          <path class="mymap-planner__profile-line" data-planner="profile-line" d=""></path>
        </svg>
      </div>

      <div class="mymap-planner__stats">
        <div class="mymap-planner__stat">
          <span class="mymap-planner__stat-label t-label-sm">DIST</span>
          <span class="mymap-planner__stat-value t-title-md" data-planner="stat-distance">&mdash;</span>
        </div>
        <div class="mymap-planner__stat">
          <span class="mymap-planner__stat-label t-label-sm">ELEV</span>
          <span class="mymap-planner__stat-value t-title-md" data-planner="stat-elevation">&mdash;</span>
        </div>
        <div class="mymap-planner__stat">
          <span class="mymap-planner__stat-label t-label-sm">EST. TIME</span>
          <span class="mymap-planner__stat-value t-title-md" data-planner="stat-time">&mdash;</span>
        </div>
        <div class="mymap-planner__stat">
          <span class="mymap-planner__stat-label t-label-sm">POINTS</span>
          <span class="mymap-planner__stat-value t-title-md" data-planner="stat-points">0</span>
        </div>
      </div>

      <footer class="mymap-planner__footer">
        <button type="button" class="btn btn--primary mymap-planner__save" data-planner="save" disabled>
          <span class="material-symbols-outlined" aria-hidden="true">save</span>
          <span>Save Route</span>
        </button>
        <button type="button" class="btn btn--secondary" data-planner="cancel">Cancel</button>
      </footer>

      <%# Exit-confirmation (§6.2: confirm when unsaved changes exist). %>
      <div class="planner-confirm" data-planner="confirm" hidden>
        <div class="planner-confirm__card" role="dialog" aria-modal="true" aria-labelledby="planner-confirm-title">
          <h3 class="t-headline-sm c-primary" id="planner-confirm-title">Discard unsaved changes?</h3>
          <p class="t-body-sm c-secondary">Your drawn route has not been saved yet.</p>
          <footer class="planner-confirm__actions">
            <button type="button" class="btn btn--secondary" data-planner="confirm-stay">Keep editing</button>
            <button type="button" class="btn btn--danger" data-planner="confirm-discard">Discard changes</button>
          </footer>
        </div>
      </div>
    </aside>

    <%# Drawer card template — cloned per route by the controller; every
        dynamic value is set via textContent/src, never injected HTML.
        Metrics + thumb reuse the shared card partial, rendered for a blank
        route (every metric an em dash, thumb the empty fallback) and filled
        per clone by the controller. linked: false — the card itself is the
        click target (select the route on the map), so no route link inside. %>
    <template data-my-map-target="cardTemplate">
      <article class="mymap-card" role="button" tabindex="0">
        <div class="mymap-card__head">
          <div class="mymap-card__headings">
            <div class="mymap-card__badges">
              <span class="mymap-card__badge" data-card-field="sport"></span>
              <span class="c-tertiary t-label-sm" data-card-field="tier"></span>
            </div>
            <h3 class="mymap-card__title" data-card-field="title"></h3>
          </div>
        </div>
        <%= render "shared/card_metrics_n_thumb",
                   route: Route.new, class_prefix: "mymap-card", linked: false %>
      </article>
    </template>
  </div>

  <%# Find-new-routes filter modal (design-refs/stitch_explorer_v0.14):
      segmented route type, dual-thumb distance range (two overlaid native
      sliders), elevation "up to" slider and duration radio cards. The
      generic modal overlay controller owns open/close (opened from the
      sub-bar button and the drawer chips' Edit via data-modal-open); the
      find-routes controller owns the control state and hands the semantic
      filter set to my-map on Find (find-routes:apply bubbles to the
      my-map root — the modal must stay inside it). %>
  <%# POI editor (technote.ROUTE-DRAW.md §7): opened by the planner when the
      rider creates or edits a Point of Interest. Title, description, link
      and image; the planner module owns open/close and reads the fields on
      Save. Image upload POSTs to /planner/poi_images on pick and shows the
      preview immediately (the signed_id rides along in the editor state). %>
  <div class="modal" id="planner-poi-modal" data-planner="poi-modal" aria-hidden="true">
    <div class="modal__backdrop" data-planner="poi-modal-backdrop" aria-hidden="true"></div>
    <div class="modal__card planner-poi" role="dialog" aria-modal="true" aria-labelledby="planner-poi-title">
      <header class="modal__head">
        <div class="planner-poi__headings">
          <span class="material-symbols-outlined planner-poi__pin" aria-hidden="true">location_on</span>
          <h2 class="t-headline-sm c-primary" id="planner-poi-title" data-planner="poi-heading">Point of interest</h2>
        </div>
        <button type="button" class="icon-btn" data-planner="poi-modal-close" aria-label="Close dialog">
          <span class="material-symbols-outlined">close</span>
        </button>
      </header>

      <form data-planner="poi-form">
        <div class="planner-poi__image" data-planner="poi-image-wrap" hidden>
          <img class="planner-poi__image-img" data-planner="poi-image-preview" alt="Point of interest preview">
          <button type="button" class="planner-poi__image-remove" data-planner="poi-image-remove" title="Remove image">
            <span class="material-symbols-outlined" aria-hidden="true">delete</span>
          </button>
        </div>
        <label class="planner-poi__upload" data-planner="poi-upload">
          <span class="material-symbols-outlined" aria-hidden="true">add_photo_alternate</span>
          <span data-planner="poi-upload-label">Add an image</span>
          <input type="file" accept="image/png,image/jpeg,image/webp" class="visually-hidden"
                 data-planner="poi-image">
        </label>
        <p class="planner-poi__upload-error t-body-sm c-danger" data-planner="poi-upload-error" hidden></p>

        <div class="planner-poi__field">
          <label class="find-routes__label" for="planner-poi-title-input">Title</label>
          <input type="text" id="planner-poi-title-input" class="planner-poi__input" data-planner="poi-title"
                 maxlength="200" placeholder="e.g. Water refill, viewpoint, bakery&hellip;" autocomplete="off">
        </div>
        <div class="planner-poi__field">
          <label class="find-routes__label" for="planner-poi-description-input">Description</label>
          <textarea id="planner-poi-description-input" class="planner-poi__input planner-poi__input--area"
                    data-planner="poi-description" rows="3" maxlength="2000"
                    placeholder="What should future-you know about this place?"></textarea>
        </div>
        <div class="planner-poi__field">
          <label class="find-routes__label" for="planner-poi-url-input">External link</label>
          <input type="url" id="planner-poi-url-input" class="planner-poi__input" data-planner="poi-url"
                 maxlength="1024" placeholder="https://&hellip;" autocomplete="off">
        </div>

        <footer class="modal__actions">
          <button type="button" class="btn btn--secondary" data-planner="poi-cancel">Cancel</button>
          <button type="submit" class="btn btn--primary" data-planner="poi-save">
            <span class="material-symbols-outlined" aria-hidden="true">flag</span>
            <span data-planner="poi-save-label">Add to Route</span>
          </button>
        </footer>
      </form>
    </div>
  </div>

  <div class="modal" id="find-routes-modal"
       data-controller="modal find-routes" data-modal-id="find-routes" aria-hidden="true">
    <div class="modal__backdrop" data-action="click->modal#close" aria-hidden="true"></div>
    <div class="modal__card modal__card--find-routes" role="dialog" aria-modal="true" aria-labelledby="find-routes-title">
      <header class="modal__head">
        <div>
          <h2 class="t-headline-sm c-primary" id="find-routes-title">Find new routes</h2>
          <p class="t-body-sm c-secondary">Your next adventure</p>
        </div>
        <button type="button" class="icon-btn" data-action="modal#close" aria-label="Close dialog">
          <span class="material-symbols-outlined">close</span>
        </button>
      </header>

      <form data-action="submit->find-routes#apply">
        <div class="find-routes__field">
          <span class="find-routes__label">Route type</span>
          <div class="find-routes__segment" role="group" aria-label="Route type">
            <%# Leading "All" is a UI concept (no sport constraint), not a
                category — the categories themselves come from
                Map::RouteFinder::SPORT_CATEGORIES via find_sport_categories,
                the single source of truth shared with the SQL matching and
                the drawer chips. %>
            <button type="button" class="find-routes__segment-btn is-active" data-sport="all" data-action="find-routes#pickSport">All</button>
            <% find_sport_categories.each do |category| %>
              <button type="button" class="find-routes__segment-btn"
                      data-sport="<%= category[:key] %>" data-action="find-routes#pickSport"><%= category[:label] %></button>
            <% end %>
          </div>
        </div>

        <div class="find-routes__field">
          <div class="find-routes__label-row">
            <span class="find-routes__label">Route distance</span>
            <span class="find-routes__value" data-find-routes-target="distanceLabel">20 &ndash; 98 km</span>
          </div>
          <div class="find-routes__slider">
            <div class="find-routes__slider-fill" data-find-routes-target="distanceFill"></div>
            <input type="range" class="find-routes__range" min="0" max="180" step="1" value="0"
                   autocomplete="off"
                   aria-label="Minimum distance in kilometers"
                   data-find-routes-target="distanceMin" data-action="input->find-routes#distanceChanged">
            <input type="range" class="find-routes__range" min="0" max="180" step="1" value="98"
                   autocomplete="off"
                   aria-label="Maximum distance in kilometers"
                   data-find-routes-target="distanceMax" data-action="input->find-routes#distanceChanged">
          </div>
          <div class="find-routes__scale t-code-sm c-tertiary">
            <span>0 km</span><span>50 km</span><span>100 km</span><span>180+ km</span>
          </div>
        </div>

        <div class="find-routes__field">
          <div class="find-routes__label-row">
            <span class="find-routes__label">Elevation gain</span>
            <span class="find-routes__value" data-find-routes-target="elevationLabel">&le; 1,500 m</span>
          </div>
          <div class="find-routes__slider">
            <div class="find-routes__slider-fill" data-find-routes-target="elevationFill"></div>
            <input type="range" class="find-routes__range" min="200" max="3000" step="100" value="1500"
                   autocomplete="off"
                   aria-label="Maximum elevation gain in meters"
                   data-find-routes-target="elevation" data-action="input->find-routes#elevationChanged">
          </div>
          <div class="find-routes__scale t-code-sm c-tertiary">
            <span>200 m</span><span>1,600 m</span><span>3,000+ m</span>
          </div>
        </div>

        <div class="find-routes__field">
          <span class="find-routes__label">Duration</span>
          <div class="find-routes__duration" role="radiogroup" aria-label="Duration">
            <label class="find-routes__duration-card find-routes__duration-card--any is-active">
              <input type="radio" name="find-routes-duration" value="any" checked
                     data-find-routes-target="durationOption" data-action="change->find-routes#durationChanged">
              <span class="find-routes__duration-title">Any duration</span>
              <span class="find-routes__duration-hint t-code-sm">no limit</span>
            </label>
            <label class="find-routes__duration-card">
              <input type="radio" name="find-routes-duration" value="under-1h"
                     data-find-routes-target="durationOption" data-action="change->find-routes#durationChanged">
              <span class="find-routes__duration-title">Under 1 h</span>
              <span class="find-routes__duration-hint t-code-sm">up to 60 min</span>
            </label>
            <label class="find-routes__duration-card">
              <input type="radio" name="find-routes-duration" value="1-4h"
                     data-find-routes-target="durationOption" data-action="change->find-routes#durationChanged">
              <span class="find-routes__duration-title">1&ndash;4 h</span>
              <span class="find-routes__duration-hint t-code-sm">60 min &ndash; 4 h</span>
            </label>
            <label class="find-routes__duration-card">
              <input type="radio" name="find-routes-duration" value="4-6h"
                     data-find-routes-target="durationOption" data-action="change->find-routes#durationChanged">
              <span class="find-routes__duration-title">4&ndash;6 h</span>
              <span class="find-routes__duration-hint t-code-sm">4 h &ndash; 6 h</span>
            </label>
            <label class="find-routes__duration-card">
              <input type="radio" name="find-routes-duration" value="6h-plus"
                     data-find-routes-target="durationOption" data-action="change->find-routes#durationChanged">
              <span class="find-routes__duration-title">6 h+</span>
              <span class="find-routes__duration-hint t-code-sm">6 h and up</span>
            </label>
          </div>
        </div>

        <footer class="modal__actions">
          <button type="button" class="btn btn--ghost find-routes__reset" data-action="find-routes#reset">
            <span class="material-symbols-outlined" aria-hidden="true">restart_alt</span>
            <span>Reset</span>
          </button>
          <button type="button" class="btn btn--secondary" data-action="modal#close">Cancel</button>
          <button type="submit" class="btn btn--primary">
            <span class="material-symbols-outlined" aria-hidden="true">search</span>
            <span>Find</span>
          </button>
        </footer>
      </form>
    </div>
  </div>
</div>
</div>
