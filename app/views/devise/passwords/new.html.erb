<div class="auth">
  <div class="auth-card">
    <div class="auth-card__body">
      <%= image_tag "explorer_logo.svg", alt: "Explorer logo", size: "80x80",
                    class: "auth-card__logo" %>
      <h1 class="auth-card__title">Reset your password</h1>
      <p class="auth-card__lede">
        Enter your verified email or username and we'll send you instructions
        to reset your password.
      </p>

      <%= form_for resource, as: resource_name,
                   url: password_path(resource_name),
                   html: { class: "auth-form" } do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="auth-field">
          <%= f.label :email, "Email address or username", class: "field-label" %>
          <%# text_field (not email_field) so username-only requests pass browser validation %>
          <%= f.text_field :email, autofocus: true, autocomplete: "username",
                           placeholder: "Enter email or username", class: "input" %>
          <p class="auth-field__hint">We'll email you a secure link valid for 1 hour.</p>
        </div>

        <%= f.submit "Send reset instructions", class: "btn btn--primary btn--block" %>
      <% end %>
    </div>

    <footer class="auth-card__footer">
      <p class="auth-card__footer-text">
        Remember your password?
        <%= link_to "Sign in", new_session_path(resource_name),
                    class: "auth-card__footer-link" %>
      </p>
    </footer>
  </div>
</div>
