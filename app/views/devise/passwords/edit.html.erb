<div class="auth">
  <div class="auth-card">
    <div class="auth-card__body">
      <%= image_tag "explorer_logo.svg", alt: "Explorer logo", size: "80x80",
                    class: "auth-card__logo" %>
      <h1 class="auth-card__title">Choose a new password</h1>
      <p class="auth-card__lede">Set a new password for your Explorer account.</p>

      <%= form_for resource, as: resource_name,
                   url: password_path(resource_name),
                   html: { method: :put, class: "auth-form" } do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="auth-field">
          <%= f.label :password, "New password", class: "field-label" %>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
                               placeholder: "Enter your password", class: "input" %>
          <% if @minimum_password_length %>
            <p class="auth-field__hint">
              <%= @minimum_password_length %> characters minimum
            </p>
          <% end %>
        </div>

        <div class="auth-field">
          <%= f.label :password_confirmation, "Confirm new password", class: "field-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
                               placeholder: "Confirm your password", class: "input" %>
        </div>

        <%= f.submit "Update password", class: "btn btn--primary btn--block" %>
      <% end %>
    </div>

    <footer class="auth-card__footer">
      <p class="auth-card__footer-text">
        Remember your password?
        <%= link_to "Sign in", new_session_path(resource_name),
                    class: "auth-card__footer-link" %>
      </p>
    </footer>
  </div>
</div>
