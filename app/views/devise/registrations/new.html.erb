<div class="auth">
  <div class="auth-card">
    <div class="auth-card__body">
      <%= image_tag "explorer_logo.svg", alt: "Explorer logo", size: "80x80",
                    class: "auth-card__logo" %>
      <h1 class="auth-card__title">Create your account</h1>
      <p class="auth-card__lede">Welcome! Please fill in the details to get started</p>

      <%= form_for resource, as: resource_name,
                   url: registration_path(resource_name),
                   html: { class: "auth-form" } do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="auth-grid">
          <div class="auth-field">
            <%= f.label :first_name, "First name", class: "field-label" %>
            <%= f.text_field :first_name, placeholder: "Enter first name", 
                             autofocus: true, autocomplete: "given-name",
                             class: "input" %>
          </div>

          <div class="auth-field">
            <%= f.label :last_name, "Last name", class: "field-label" %>
            <%= f.text_field :last_name, placeholder: "Enter last name", 
                             autocomplete: "family-name", class: "input" %>
          </div>
        </div>

        <div class="auth-field">
          <%= f.label :username, class: "field-label" %>
          <%= f.text_field :username, autocomplete: "username",
                           placeholder: "Letters, numbers and underscores", class: "input" %>
        </div>

        <div class="auth-field">
          <%= f.label :email, "Email address", class: "field-label" %>
          <%= f.email_field :email, autocomplete: "email",
                            placeholder: "Enter your email address", class: "input" %>
        </div>

        <div class="auth-field">
          <%= f.label :password, class: "field-label" %>
          <%= f.password_field :password, autocomplete: "new-password",
                               placeholder: "Enter your password", class: "input" %>
          <% if @minimum_password_length %>
            <p class="auth-field__hint">
              <%= @minimum_password_length %> characters minimum
            </p>
          <% end %>
        </div>

        <div class="auth-field">
          <%= f.label :password_confirmation, "Confirm password", class: "field-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
                               placeholder: "Confirm your password", class: "input" %>
        </div>

        <%= f.submit "Continue", class: "btn btn--primary btn--block" %>
      <% end %>
    </div>

    <footer class="auth-card__footer">
      <p class="auth-card__footer-text">
        Already have an account?
        <%= link_to "Sign in", new_session_path(resource_name),
                    class: "auth-card__footer-link" %>
      </p>
    </footer>
  </div>
</div>
