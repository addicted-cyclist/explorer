<div class="auth">
  <div class="auth-card">
    <div class="auth-card__body">
      <%= image_tag "explorer_logo.svg", alt: "Explorer logo", size: "80x80",
                    class: "auth-card__logo" %>
      <h1 class="auth-card__title">Sign in to Explorer</h1>
      <p class="auth-card__lede">Welcome back! Please sign in to continue</p>

      <%= form_for resource, as: resource_name,
                   url: session_path(resource_name),
                   html: { class: "auth-form" } do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="auth-field">
          <%= f.label :email, "Email or username", class: "field-label" %>
          <%# text_field (not email_field) so username-only logins pass browser validation %>
          <%= f.text_field :email, autofocus: true, autocomplete: "username",
                           placeholder: "Enter email or username", class: "input" %>
        </div>

        <div class="auth-field">
          <%= f.label :password, class: "field-label" %>
          <%= f.password_field :password, autocomplete: "current-password",
                               placeholder: "Enter your password", class: "input" %>        
        </div>

        <% if devise_mapping.recoverable? %>
            <%= link_to "Forgot your password?", new_password_path(resource_name),
                        class: "auth-field__aside" %>
        <% end %> 

        <%= f.submit "Continue", class: "btn btn--primary btn--block" %>
      <% end %>
    </div>

    <footer class="auth-card__footer">
      <p class="auth-card__footer-text">
        Don't have an account?
        <%= link_to "Sign up", new_registration_path(resource_name),
                    class: "auth-card__footer-link" %>
      </p>
    </footer>
  </div>
</div>
